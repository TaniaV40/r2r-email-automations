    {
      "parameters": {
        "jsCode": "// 1. Grab all items from the Google Sheet\nconst allItems = $input.all(); \n\nconst summary = {\n  \"Kings Cliffe\": 0,\n  \"Padel\": 0,\n  \"Thrapston\": 0,\n  \"Uppingham\": 0,\n  \"Ketton\": 0,\n  \"Medbourne\": 0, // Added Medbourne\n  \"Individuals\": 0,\n  \"CAMP\": 0\n};\n\n// 2. Loop through every row\nfor (const item of allItems) {\n  const row = item.json;\n\n  // Helper to find the right column regardless of colons/spaces\n  const getVal = (name) => {\n    const key = Object.keys(row).find(k => k.toLowerCase().includes(name.toLowerCase()));\n    return key ? String(row[key]) : \"\";\n  };\n\n  const loc = getVal(\"Location\");\n  const type = getVal(\"Lesson Type\");\n  \n  // Find the price (looks for \"Total\" or \"£\")\n  const priceKey = Object.keys(row).find(k => k.includes(\"Total\") || k.includes(\"£\"));\n  const total = priceKey ? parseFloat(row[priceKey]) : 0;\n\n  // 3. IDENTIFY AND TOTAL\n  if (type.toLowerCase().includes(\"camp\")) {\n    summary[\"CAMP\"] += total;\n  } \n  else if (loc.includes(\"Kings Cliffe\")) summary[\"Kings Cliffe\"] += total;\n  else if (loc.includes(\"Thrapston\")) summary[\"Thrapston\"] += total;\n  else if (loc.includes(\"Uppingham\")) summary[\"Uppingham\"] += total;\n  else if (loc.includes(\"Ketton\")) summary[\"Ketton\"] += total;\n  else if (loc.includes(\"Medbourne\")) summary[\"Medbourne\"] += total; // Added Logic\n  else if (loc.includes(\"Padel\") || loc.includes(\"Manor\")) summary[\"Padel\"] += total;\n  else if (type.toLowerCase().includes(\"individual\")) summary[\"Individuals\"] += total;\n}\n\n// 4. Calculate a GRAND TOTAL of everything\nsummary[\"GRAND TOTAL\"] = Object.values(summary).reduce((a, b) => a + b, 0);\n\nreturn [{ json: summary }];"
      },
